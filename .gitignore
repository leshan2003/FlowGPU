# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Raw EDA artefacts: large, and the reports embed absolute paths from
# whichever machine ran the flow.  The distilled result that the simulator
# actually consumes -- eda/results/energy_db.json -- is committed.
eda/results/reports/
eda/results/power/
eda/results/energy_raw.json
eda/results/*.log
eda/work/

# Run logs (may contain host-specific paths)
*.log
results/*.log
.tmp-stage0-config-v*/

# Superseded Stage 0 development checkpoints; canonical bundles are listed
# explicitly in docs/MOE_STAGE0_执行审计.md.
experiments/moe_2026_stage0_*/
!experiments/moe_2026_stage0_final_*/
experiments/moe_2026_screen_*/
!experiments/moe_2026_screen_final_v2_*/
!experiments/moe_2026_screen_qwen_v2/
!experiments/moe_2026_screen_deepseek_v2/

